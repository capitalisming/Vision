# AI-assisted (Claude Code), reviewed by a team member.
# Opens pi/status.html full screen on the Pi's monitor after login (desktop autostart).
# Install: mkdir -p ~/.config/autostart && cp pi/sensor-kiosk.desktop ~/.config/autostart/
# Remove:  rm ~/.config/autostart/sensor-kiosk.desktop   (exit kiosk now: Alt+F4)
[Desktop Entry]
Type=Application
Name=Vision sensor status
Exec=sh -c 'sleep 8; B=$(command -v chromium || command -v chromium-browser); exec "$B" --kiosk --noerrdialogs --disable-infobars --no-first-run --password-store=basic http://localhost:8000/status.html'
X-GNOME-Autostart-enabled=true
